; Engine configuration file.
; Pflanzenwesen – Alpha 1.x (Versionsschema: docs/ROADMAP_ALPHA.md Abschnitt 4)

config_version=5

[application]

config/name="Pflanzenwesen"
config/description="3D-Voxel-Zivilisationssimulation mit Pflanzenwesen"
config/version="alpha-1.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.81
3d/default_linear_damp=0.0

[rendering]

renderer/rendering_method="forward_plus"
